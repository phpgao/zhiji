{
  "name": "zhiji",
  "version": "1.0.0",
  "description": "知集 (ZhiJi) — 知乎内容采集器，支持单/多回答采集、高保真 Markdown 导出、Obsidian 直存与本地 ZIP 打包 (Chrome 扩展 + 油猴脚本)",
  "main": "zhiji.user.js",
  "scripts": {
    "build": "node scripts/generate-icons.js && node scripts/build.js",
    "build:icons": "node scripts/generate-icons.js",
    "pack": "node scripts/package.js",
    "test": "node test/markdown.test.js && node test/parser.test.js && node test/config.test.js",
    "test:md": "node test/markdown.test.js",
    "test:parser": "node test/parser.test.js",
    "test:config": "node test/config.test.js"
  },
  "keywords": [
    "zhihu",
    "obsidian",
    "clipper",
    "markdown",
    "browser-extension",
    "chrome-extension",
    "userscript",
    "tampermonkey"
  ],
  "author": "ZhiJi",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0"
  }
}
